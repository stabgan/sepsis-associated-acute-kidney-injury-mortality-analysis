\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Main conformal results across repeated grouped splits. Coverage is the fraction of patients whose true label falls within the conformal prediction set. Certain fraction is the proportion of patients receiving a singleton (Alert or Clear) rather than a deferred (\{0,1\}) prediction. All estimates are means $\pm $ bootstrap confidence intervals across 21 subject-grouped seeds.}}{14}{table.caption.32}\protected@file@percent }
\newlabel{tab:conformal-main}{{3}{14}{Main conformal results across repeated grouped splits. Coverage is the fraction of patients whose true label falls within the conformal prediction set. Certain fraction is the proportion of patients receiving a singleton (Alert or Clear) rather than a deferred (\{0,1\}) prediction. All estimates are means $\pm $ bootstrap confidence intervals across 21 subject-grouped seeds}{table.caption.32}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Conformal operating-characteristic curve. As $\alpha $ increases, coverage decreases and the certain-decision fraction rises, tracing the fundamental coverage--automation tradeoff.}}{14}{figure.caption.33}\protected@file@percent }
\newlabel{fig:conformal-curve}{{6}{14}{Conformal operating-characteristic curve. As $\alpha $ increases, coverage decreases and the certain-decision fraction rises, tracing the fundamental coverage--automation tradeoff}{figure.caption.33}{}}
