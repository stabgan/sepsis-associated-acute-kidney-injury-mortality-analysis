\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Conformal selective-triage decision flow. A calibrated risk model produces a probability estimate at T24. Mondrian conformal thresholds, estimated on a held-out calibration set, convert this probability into a prediction set. The set cardinality determines the triage action: $\{1\} \to $ \emph  {Alert}, $\{0\} \to $ \emph  {Clear}, $\{0,1\} \to $ \emph  {Defer}.}}{8}{figure.caption.19}\protected@file@percent }
\newlabel{fig:conformal-flow}{{2}{8}{Conformal selective-triage decision flow. A calibrated risk model produces a probability estimate at T24. Mondrian conformal thresholds, estimated on a held-out calibration set, convert this probability into a prediction set. The set cardinality determines the triage action: $\{1\} \to $ \emph {Alert}, $\{0\} \to $ \emph {Clear}, $\{0,1\} \to $ \emph {Defer}}{figure.caption.19}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.6}Disagreement-Based Selective Triage}{8}{subsection.2.6}\protected@file@percent }
\newlabel{sec:disagreement}{{2.6}{8}{Disagreement-Based Selective Triage}{subsection.2.6}{}}
\newlabel{eq:disagreement}{{5}{8}{Disagreement-Based Selective Triage}{equation.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Disagreement-based selective-triage comparator (ablation). A full-feature model and a physiology-only model independently score each patient. The absolute probability gap serves as a defer signal: large disagreement triggers deferral to clinician review, while concordant predictions above or below risk thresholds produce \emph  {Alert} or \emph  {Clear} decisions. Unlike conformal triage, this approach provides no formal coverage guarantee.}}{9}{figure.caption.20}\protected@file@percent }
\newlabel{fig:disagreement-flow}{{3}{9}{Disagreement-based selective-triage comparator (ablation). A full-feature model and a physiology-only model independently score each patient. The absolute probability gap serves as a defer signal: large disagreement triggers deferral to clinician review, while concordant predictions above or below risk thresholds produce \emph {Alert} or \emph {Clear} decisions. Unlike conformal triage, this approach provides no formal coverage guarantee}{figure.caption.20}{}}
