\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Multi-model consensus conformal results. The union strategy defers whenever any constituent model is uncertain; the intersection strategy acts only when all models agree. Single-model results (XGBoost) are repeated from Table~\ref {tab:conformal-main} for comparison.}}{16}{table.caption.34}\protected@file@percent }
\newlabel{tab:conformal-consensus}{{4}{16}{Multi-model consensus conformal results. The union strategy defers whenever any constituent model is uncertain; the intersection strategy acts only when all models agree. Single-model results (XGBoost) are repeated from Table~\ref {tab:conformal-main} for comparison}{table.caption.34}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Multi-model consensus trade-off panel. The union strategy achieves the highest reliability (alert PPV and clear NPV) at the cost of the lowest automation rate; the intersection strategy maximizes automation but sacrifices reliability.}}{16}{figure.caption.35}\protected@file@percent }
\newlabel{fig:consensus}{{7}{16}{Multi-model consensus trade-off panel. The union strategy achieves the highest reliability (alert PPV and clear NPV) at the cost of the lowest automation rate; the intersection strategy maximizes automation but sacrifices reliability}{figure.caption.35}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Shift robustness versus fixed-threshold policies. Conformal coverage remains stable under increasing missingness because the framework defers more cases; fixed thresholds lose recall without signaling increased uncertainty.}}{17}{table.caption.36}\protected@file@percent }
\newlabel{tab:shift}{{5}{17}{Shift robustness versus fixed-threshold policies. Conformal coverage remains stable under increasing missingness because the framework defers more cases; fixed thresholds lose recall without signaling increased uncertainty}{table.caption.36}{}}
