\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces End-to-end study workflow. The raw SA-AKI cohort is derived from MIMIC-IV~v3.1 via Sepsis-3 and KDIGO criteria, audited against a data contract, and split into subject-grouped partitions. Three evaluation tracks (conventional baselines, disagreement-based selective triage (ablation), and Mondrian conformal selective triage (primary)) feed into a unified manuscript asset pipeline that produces all tables, figures, and decision-curve analyses reported in this paper.}}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:workflow}{{1}{3}{End-to-end study workflow. The raw SA-AKI cohort is derived from MIMIC-IV~v3.1 via Sepsis-3 and KDIGO criteria, audited against a data contract, and split into subject-grouped partitions. Three evaluation tracks (conventional baselines, disagreement-based selective triage (ablation), and Mondrian conformal selective triage (primary)) feed into a unified manuscript asset pipeline that produces all tables, figures, and decision-curve analyses reported in this paper}{figure.caption.1}{}}
